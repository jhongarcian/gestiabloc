# Frontend configuration. Copy to apps/react-ui/.env on a fresh checkout.
# NEXT_PUBLIC_ values are included in browser code; use public credentials only.

NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# Public values from the same Supabase project as the backend.
# Required for signed file uploads; the backend keeps its secret key separately.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
