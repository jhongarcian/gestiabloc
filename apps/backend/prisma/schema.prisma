// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  NONE
  SAAS_OWNER
  SUPPORT
  MARKETING
}

enum TenantRole {
  TENANT_ADMIN
  TENANT_USER
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum PlanKey {
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum OtpPurpose {
  LOGIN
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String
  passwordHash String?
  platformRole PlatformRole @default(NONE)

  otpEnabled   Boolean   @default(true)

  sessions      Session[]
  memberships Membership[]
  loginChallenges LoginChallenge[]
  emailVerifications EmailVerification[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified Boolean   @default(false)
  image         String?

}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model LoginChallenge {
  id        String   @id @default(uuid())
  userId    String
  nonceHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailOtp {
  id        String     @id @default(uuid())
  email     String
  purpose   OtpPurpose @default(LOGIN)

  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int        @default(0)

  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

model Tenant {
  id   String @id @default(uuid())
  name String
  slug String @unique
  email String?
  phone String?
  addressLine1 String?
  addressLine2 String?
  city String?
  state String?
  postalCode String?
  country String?
  timezone String?
  website String?
  emailVerified Boolean @default(false)

  members      Membership[]
  invites      Invite[]
  subscription TenantSubscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Membership {
  id       String           @id @default(uuid())
  userId   String
  tenantId String
  role     TenantRole
  status   MembershipStatus @default(ACTIVE)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

model Invite {
  id        String       @id @default(uuid())
  tenantId  String
  email     String
  role      TenantRole
  tokenHash String       @unique
  status    InviteStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

model TenantSubscription {
  id       String @id @default(uuid())
  tenantId String @unique

  planKey   PlanKey            @default(STARTER)
  seatLimit Int                @default(3)
  status    SubscriptionStatus @default(NONE)

  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])

}
