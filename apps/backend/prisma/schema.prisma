// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  NONE
  SAAS_OWNER
  SUPPORT
  MARKETING
}

enum TenantRole {
  TENANT_ADMIN
  TENANT_USER
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum SecurityLevel {
  LOW
  MEDIUM
  MAX
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum PlanKey {
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum OtpPurpose {
  LOGIN
}

enum FilePurpose {
  AVATAR
  GENERIC
}

enum ContactGender {
  FEMALE
  MALE
  NON_BINARY
  OTHER
  UNKNOWN
}

enum ContactSmokerStatus {
  UNKNOWN
  NEVER
  CURRENT
  FORMER
}

enum ContactCustomFieldType {
  TEXT
  NUMBER
  PHONE
  CURRENCY
  DATE
  SELECT
  MULTI_SELECT
  RADIO
  TEXTAREA
  CHECKBOX
}

enum ContactRelationshipType {
  FATHER
  MOTHER
  PARENT
  SON
  DAUGHTER
  CHILD
  HUSBAND
  WIFE
  SPOUSE
  PARTNER
  BROTHER
  SISTER
  SIBLING
  GRANDFATHER
  GRANDMOTHER
  GRANDPARENT
  GRANDSON
  GRANDDAUGHTER
  GRANDCHILD
  UNCLE
  AUNT
  AUNT_OR_UNCLE
  NEPHEW
  NIECE
  NIECE_OR_NEPHEW
  COUSIN
  GUARDIAN
  WARD
  CAREGIVER
  DEPENDENT
  FRIEND
  OTHER
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String
  passwordHash String?
  platformRole PlatformRole @default(NONE)

  otpEnabled Boolean @default(true)

  sessions            Session[]
  memberships         Membership[]
  files               File[]
  loginChallenges     LoginChallenge[]
  emailVerifications  EmailVerification[]
  passwordResetTokens PasswordResetToken[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified Boolean   @default(false)
  image         String?
  lastLoginAt   DateTime?
}

model File {
  id          String      @id @default(uuid())
  tenantId    String
  key         String      @unique
  contentType String
  size        Int?
  createdById String
  purpose     FilePurpose @default(GENERIC)

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([createdById])
  @@index([purpose])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model LoginChallenge {
  id        String   @id @default(uuid())
  userId    String
  nonceHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailOtp {
  id      String     @id @default(uuid())
  email   String
  purpose OtpPurpose @default(LOGIN)

  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)

  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Tenant {
  id            String  @id @default(uuid())
  name          String
  slug          String  @unique
  email         String?
  phone         String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  state         String?
  postalCode    String?
  country       String?
  timezone      String?
  website       String?
  emailVerified Boolean @default(false)

  members              Membership[]
  files                File[]
  invites              Invite[]
  subscription         TenantSubscription?
  contacts             Contact[]
  contactStatusConfigs ContactStatusConfig[]
  contactCustomFields  ContactCustomField[]
  contactCustomFieldValues ContactCustomFieldValue[]
  contactRelationships ContactRelationship[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailVerification {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Membership {
  id            String           @id @default(uuid())
  userId        String
  tenantId      String
  role          TenantRole
  status        MembershipStatus @default(ACTIVE)
  securityLevel SecurityLevel    @default(LOW)

  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant                  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignedContacts        Contact[] @relation("ContactAssignedToMembership")
  servicingAgentContacts  Contact[] @relation("ContactServicingAgentMembership")
  additionalAgentContacts Contact[] @relation("ContactAdditionalAgentMembership")

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, securityLevel])
}

model Invite {
  id        String       @id @default(uuid())
  tenantId  String
  email     String
  role      TenantRole
  tokenHash String       @unique
  status    InviteStatus @default(PENDING)

  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  acceptedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

model TenantSubscription {
  id       String @id @default(uuid())
  tenantId String @unique

  planKey   PlanKey            @default(STARTER)
  seatLimit Int                @default(3)
  status    SubscriptionStatus @default(NONE)

  stripeCustomerId     String?
  stripeSubscriptionId String?
  stripePriceId        String?
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([status])
}

model ContactStatusConfig {
  id              String  @id @default(uuid())
  tenantId        String
  name            String
  bgColor         String
  textColor       String
  sortOrder       Int     @default(0)
  isActive        Boolean @default(true)
  isSystemDefault Boolean @default(false)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts Contact[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, sortOrder])
}

model ContactCustomField {
  id          String                 @id @default(uuid())
  tenantId    String
  key         String
  label       String
  description String?
  fieldType   ContactCustomFieldType
  isRequired  Boolean                @default(false)
  isEncrypted Boolean                @default(false)
  isActive    Boolean                @default(true)
  options     Json?
  sortOrder   Int                    @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values ContactCustomFieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, key])
  @@index([tenantId, sortOrder])
}

model ContactCustomFieldValue {
  id       String @id @default(uuid())
  tenantId String
  contactId String
  fieldId  String
  value    Json?
  valueCiphertext String?
  valueIv         String?
  valueAuthTag    String?
  valueKeyVersion Int?

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact  Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  field    ContactCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, contactId, fieldId])
  @@index([tenantId, contactId])
  @@index([tenantId, fieldId])
}

model Contact {
  id       String @id @default(uuid())
  tenantId String

  firstName  String
  middleName String?
  lastName   String

  phone          String?
  secondaryPhone String?
  email          String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  mailingAddressLine1 String?
  mailingAddressLine2 String?
  mailingCity         String?
  mailingState        String?
  mailingPostalCode   String?
  mailingCountry      String?

  statusConfigId   String?
  assignedToUserId String?
  ssnLast4         String?
  ssnCiphertext    String?
  ssnIv            String?
  ssnAuthTag       String?
  ssnKeyVersion    Int     @default(1)

  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  dateOfBirth DateTime?
  gender      ContactGender?
  height      String?
  weight      String?
  deceasedAt  DateTime?

  medicarePartA Boolean?
  medicarePartB Boolean?
  smokerStatus  ContactSmokerStatus?

  servicingAgentUserId  String?
  additionalAgentUserId String?

  leadDate        DateTime?
  leadSource      String?
  leadOtherSource String?

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  statusConfig ContactStatusConfig? @relation(fields: [tenantId, statusConfigId], references: [tenantId, id])

  assignedToMembership      Membership? @relation("ContactAssignedToMembership", fields: [tenantId, assignedToUserId], references: [tenantId, userId])
  servicingAgentMembership  Membership? @relation("ContactServicingAgentMembership", fields: [tenantId, servicingAgentUserId], references: [tenantId, userId])
  additionalAgentMembership Membership? @relation("ContactAdditionalAgentMembership", fields: [tenantId, additionalAgentUserId], references: [tenantId, userId])
  customFieldValues         ContactCustomFieldValue[]
  outgoingRelationships     ContactRelationship[] @relation("ContactRelationshipSource")
  incomingRelationships     ContactRelationship[] @relation("ContactRelationshipTarget")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, lastName, firstName])
  @@index([tenantId, statusConfigId])
  @@index([tenantId, assignedToUserId])
  @@index([tenantId, servicingAgentUserId])
  @@index([tenantId, additionalAgentUserId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, ssnLast4])
}

model ContactRelationship {
  id                       String                  @id @default(uuid())
  tenantId                 String
  contactId                String
  relatedContactId         String
  relationshipPairKey      String
  relationshipType         ContactRelationshipType
  reciprocalRelationshipType ContactRelationshipType

  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact        Contact @relation("ContactRelationshipSource", fields: [contactId], references: [id], onDelete: Cascade)
  relatedContact Contact @relation("ContactRelationshipTarget", fields: [relatedContactId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, relationshipPairKey])
  @@index([tenantId, contactId])
  @@index([tenantId, relatedContactId])
}
