  group      CalendarStaffGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  membership Membership         @relation(fields: [tenantId, userId], references: [tenantId, userId], onDelete: Cascade)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@unique([tenantId, id])
  @@index([tenantId, groupId])
  @@index([tenantId, userId])
}

model ContactCustomFieldValue {
  id              String  @id @default(uuid())
  tenantId        String
  contactId       String
  fieldId         String
  value           Json?
  valueCiphertext String?
  valueIv         String?
  valueAuthTag    String?
  valueKeyVersion Int?

  tenant  Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  field   ContactCustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, contactId, fieldId])
  @@index([tenantId, contactId])
  @@index([tenantId, fieldId])
}

model Contact {
  id       String @id @default(uuid())
  tenantId String

  firstName  String
  middleName String?
  lastName   String

  phone          String?
  secondaryPhone String?
  email          String?

  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  postalCode   String?
  country      String?

  mailingAddressLine1 String?
  mailingAddressLine2 String?
  mailingCity         String?
  mailingState        String?
  mailingPostalCode   String?
  mailingCountry      String?

  statusConfigId   String?
  assignedToUserId String?
  ssnLast4         String?
  ssnCiphertext    String?
  ssnIv            String?
  ssnAuthTag       String?
  ssnKeyVersion    Int     @default(1)

  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship String?

  dateOfBirth DateTime?
  gender      ContactGender?
  height      String?
  weight      String?
  deceasedAt  DateTime?

  medicarePartA Boolean?
  medicarePartB Boolean?
  smokerStatus  ContactSmokerStatus?

  servicingAgentUserId  String?
  additionalAgentUserId String?

  leadDate        DateTime?
  leadSource      String?
  leadOtherSource String?

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  statusConfig ContactStatusConfig? @relation(fields: [tenantId, statusConfigId], references: [tenantId, id])

  assignedToMembership         Membership?                   @relation("ContactAssignedToMembership", fields: [tenantId, assignedToUserId], references: [tenantId, userId])
  servicingAgentMembership     Membership?                   @relation("ContactServicingAgentMembership", fields: [tenantId, servicingAgentUserId], references: [tenantId, userId])
  additionalAgentMembership    Membership?                   @relation("ContactAdditionalAgentMembership", fields: [tenantId, additionalAgentUserId], references: [tenantId, userId])
  tags                         ContactTag[]
  customFieldValues            ContactCustomFieldValue[]
  outgoingRelationships        ContactRelationship[]         @relation("ContactRelationshipSource")
  incomingRelationships        ContactRelationship[]         @relation("ContactRelationshipTarget")
  notes                        ContactNote[]
  tasks                        Task[]
  appointments                 Appointment[]
  serviceProcesses             ContactService[]
  opportunities                ContactOpportunity[]
  serviceFollowUpExecutionLogs ServiceFollowUpExecutionLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, lastName, firstName])
  @@index([tenantId, statusConfigId])
  @@index([tenantId, assignedToUserId])
  @@index([tenantId, servicingAgentUserId])
  @@index([tenantId, additionalAgentUserId])
  @@index([tenantId, email])
  @@index([tenantId, phone])
  @@index([tenantId, ssnLast4])
}

model ContactTag {
  id        String @id @default(uuid())
  tenantId  String
  contactId String
  tagId     String

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     TenantTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tenantId, id])
  @@unique([tenantId, contactId, tagId])
  @@index([tenantId, contactId])
  @@index([tenantId, tagId])
}

model ContactRelationship {
  id                         String                  @id @default(uuid())
  tenantId                   String
  contactId                  String
  relatedContactId           String
  relationshipPairKey        String
  relationshipType           ContactRelationshipType
  reciprocalRelationshipType ContactRelationshipType

  tenant         Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact        Contact @relation("ContactRelationshipSource", fields: [contactId], references: [id], onDelete: Cascade)
  relatedContact Contact @relation("ContactRelationshipTarget", fields: [relatedContactId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, relationshipPairKey])
  @@index([tenantId, contactId])
  @@index([tenantId, relatedContactId])
}

model ContactNote {
  id                           String  @id @default(uuid())
  tenantId                     String
  contactId                    String
  contactServiceId             String?
  followUpTemplateId           String?
  followUpTemplateVersionId    String?
  contactServiceFollowUpStepId String?
  title                        String
  body                         String
  createdById                  String

  tenant                     Tenant                          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact                    Contact                         @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactService             ContactService?                 @relation(fields: [contactServiceId], references: [id], onDelete: SetNull)
  followUpTemplate           ServiceFollowUpTemplate?        @relation(fields: [followUpTemplateId], references: [id], onDelete: SetNull)
  followUpTemplateVersion    ServiceFollowUpTemplateVersion? @relation(fields: [followUpTemplateVersionId], references: [id], onDelete: SetNull)
  contactServiceFollowUpStep ContactServiceFollowUpStep?     @relation(fields: [contactServiceFollowUpStepId], references: [id], onDelete: SetNull)
  createdBy                  User                            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  attachments                ContactNoteAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId, contactId, createdAt])
  @@index([tenantId, contactServiceId, createdAt])
  @@index([tenantId, followUpTemplateId, createdAt])
  @@index([tenantId, followUpTemplateVersionId, createdAt])
  @@index([tenantId, contactServiceFollowUpStepId, createdAt])
  @@index([tenantId, createdById])
}

model ContactNoteAttachment {
  id       String @id @default(uuid())
  tenantId String
  noteId   String
  fileId   String

  tenant Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  note   ContactNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  file   File        @relation(fields: [fileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([tenantId, noteId, fileId])
  @@index([tenantId, noteId])
  @@index([tenantId, fileId])
}
