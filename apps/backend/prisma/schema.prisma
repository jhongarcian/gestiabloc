// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlatformRole {
  NONE
  SAAS_OWNER
  SUPPORT
  MARKETING
}

enum TenantRole {
  TENANT_ADMIN
  TENANT_USER
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum SecurityLevel {
  LOW
  MEDIUM
  MAX
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum PlanKey {
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum TenantOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  SKIPPED
  COMPLETED
}

enum OtpPurpose {
  LOGIN
}

enum FilePurpose {
  AVATAR
  GENERIC
}

enum ContactGender {
  FEMALE
  MALE
  NON_BINARY
  OTHER
  UNKNOWN
}

enum ContactSmokerStatus {
  UNKNOWN
  NEVER
  CURRENT
  FORMER
}

enum ContactCustomFieldType {
  TEXT
  NUMBER
  PHONE
  CURRENCY
  DATE
  SELECT
  MULTI_SELECT
  RADIO
  TEXTAREA
  CHECKBOX
}

enum ServiceProfessionalKind {
  INTERNAL_USER
  EXTERNAL
}

enum InstallmentFrequency {
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum ContactServiceStatus {
  IN_PROGRESS
  PENDING_PAYMENT
  COMPLETED
  CANCELED
}

enum ContactServiceChecklistStatus {
  NOT_RECEIVED
  INFORMED
  MISSING
  RECEIVED
}

enum ContactServiceFollowUpStepStatus {
  PENDING
  ACTIVE
  COMPLETED
  SKIPPED
  POSTPONED
}

enum FollowUpRunStatus {
  RUNNING
  WAITING
  AWAITING_STEP
  COMPLETED
  FAILED
  NEEDS_REVIEW
  CANCELED
}

enum FollowUpNodeExecutionStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum FollowUpStepResolutionSource {
  USER_COMPLETED
  USER_SKIPPED
  CONDITION_SKIPPED
  FLOW_SKIPPED
}

enum TaskLinkedEntityType {
  SERVICE
  PRODUCT
}

enum TaskPriority {
  HIGH
  MEDIUM
  LOW
}

enum TaskActivityType {
  CREATED
  UPDATED
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  DUE_DATE_CHANGED
  START_DATE_CHANGED
  REMINDER_CREATED
  REMINDER_CANCELED
}

enum NotificationType {
  TASK_REMINDER
  TASK_ASSIGNED
  TASK_DUE
  FOLLOW_UP_OVERDUE
  FOLLOW_UP_FAILED
  CUSTOM_FIELD_ACCESS_REQUEST
  CUSTOM_FIELD_ACCESS_GRANTED
}

enum ContactCustomFieldAccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContactRelationshipType {
  FATHER
  MOTHER
  PARENT
  SON
  DAUGHTER
  CHILD
  HUSBAND
  WIFE
  SPOUSE
  PARTNER
  BROTHER
  SISTER
  SIBLING
  GRANDFATHER
  GRANDMOTHER
  GRANDPARENT
  GRANDSON
  GRANDDAUGHTER
  GRANDCHILD
  UNCLE
  AUNT
  AUNT_OR_UNCLE
  NEPHEW
  NIECE
  NIECE_OR_NEPHEW
  COUSIN
  GUARDIAN
  WARD
  CAREGIVER
  DEPENDENT
  FRIEND
  OTHER
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  SHOW
  NO_SHOW
  CANCELED
}

enum AppointmentAuditAction {
  CREATED
  REASSIGNED
  RESCHEDULED
  CANCELED
}

enum CalendarScheduleScope {
  TENANT
  USER
}

enum CalendarAvailabilityKind {
  OPEN
  BLOCK
}

enum CalendarBufferAvailabilityMode {
  BUSY
  UNAVAILABLE
}

enum CalendarBlockRecurrencePattern {
  NONE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum OpportunityResult {
  OPEN
  WON
  LOST
}

enum AutomationTriggerType {
  OPPORTUNITY_CREATED
  OPPORTUNITY_STAGE_CHANGED
}

enum AutomationConditionSource {
  OPPORTUNITY_VALUE
  CONTACT_STATUS
  CONTACT_CUSTOM_FIELD
  CONTACT_ASSIGNEE
  CONTACT_TAGS
}

enum AutomationOperator {
  EQUALS
  NOT_EQUALS
  CONTAINS
  NOT_CONTAINS
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN
  LESS_THAN_OR_EQUAL
  BETWEEN
  INCLUDES_ANY
  INCLUDES_ALL
  EXCLUDES_ALL
  IS_TRUE
  IS_FALSE
  IS_EMPTY
  IS_NOT_EMPTY
}

enum AutomationActionType {
  SET_CONTACT_CUSTOM_FIELD
  CLEAR_CONTACT_CUSTOM_FIELD
  SET_CONTACT_STATUS
  CLEAR_CONTACT_STATUS
  SET_CONTACT_ASSIGNEE
  CLEAR_CONTACT_ASSIGNEE
  ADD_CONTACT_TAG
  REMOVE_CONTACT_TAG
}

enum AutomationExecutionStatus {
  SUCCEEDED
  FAILED
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  name         String
  passwordHash String?
  platformRole PlatformRole @default(NONE)

  otpEnabled Boolean @default(true)

  sessions                          Session[]
  memberships                       Membership[]
  files                             File[]
  notifications                     Notification[]
  customFieldAccessRequests         ContactCustomFieldAccessRequest[] @relation("CustomFieldAccessRequester")
  customFieldAccessDecisions        ContactCustomFieldAccessRequest[] @relation("CustomFieldAccessDecidedBy")
  customFieldAccessGrants           ContactCustomFieldAccessGrant[]   @relation("CustomFieldAccessGrantedUser")
  issuedCustomFieldAccessGrants     ContactCustomFieldAccessGrant[]   @relation("CustomFieldAccessGrantedBy")
  taskActivities                    TaskActivity[]
  createdTaskReminders              TaskReminder[]                    @relation("TaskReminderCreatedBy")
  reminderAssignments               TaskReminder[]                    @relation("TaskReminderRecipient")
  contactNotes                      ContactNote[]
  contactServiceNotes               ContactServiceNote[]
  serviceProfessionals              ServiceProfessional[]
  recordedServicePayments           ContactServicePayment[]           @relation("ContactServicePaymentRecordedBy")
  contactServiceChecklistActivities ContactServiceChecklistActivity[] @relation("ContactServiceChecklistActivityActor")
  assignedServiceFollowUps          ContactServiceFollowUpStep[]      @relation("ContactServiceFollowUpAssignedUser")
  resolvedServiceFollowUps          ContactServiceFollowUpStep[]      @relation("ContactServiceFollowUpResolvedBy")
  coordinatedContactServices        ContactService[]                  @relation("ContactServiceFollowUpCoordinator")
  serviceFollowUpExecutionLogs      ServiceFollowUpExecutionLog[]     @relation("ServiceFollowUpExecutionLogActor")
  publishedFollowUpVersions         ServiceFollowUpTemplateVersion[]  @relation("ServiceFollowUpVersionPublisher")
  startedFollowUpRuns               ContactServiceFollowUpRun[]       @relation("FollowUpRunStarter")
  bookedAppointments                Appointment[]                     @relation("AppointmentBookedBy")
  assignedAppointments              Appointment[]                     @relation("AppointmentAssignedTo")
  appointmentAuditLogs              AppointmentAuditLog[]             @relation("AppointmentAuditActor")
  calendarAvailabilityRules         CalendarAvailabilityRule[]
  calendarTimeBlocks                CalendarTimeBlock[]
  calendarStaffGroupMemberships     CalendarStaffGroupMember[]
  loginChallenges                   LoginChallenge[]
  emailVerifications                EmailVerification[]
  passwordResetTokens               PasswordResetToken[]

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified Boolean   @default(false)
  image         String?
  lastLoginAt   DateTime?
}

model File {
  id          String      @id @default(uuid())
  tenantId    String
  key         String      @unique
  contentType String
  size        Int?
  createdById String
  purpose     FilePurpose @default(GENERIC)

  tenant                 Tenant                         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy              User                           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  noteAttachments        ContactNoteAttachment[]
  serviceNoteAttachments ContactServiceNoteAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([createdById])
  @@index([purpose])
}

model TaskActivity {
  id          String           @id @default(uuid())
  tenantId    String
  taskId      String
  actorUserId String?
  type        TaskActivityType
  title       String
  details     String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor  User?  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([tenantId, taskId, createdAt])
  @@index([tenantId, actorUserId, createdAt])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model LoginChallenge {
  id            String    @id @default(uuid())
  userId        String    @unique
  nonceHash     String    @unique
  expiresAt     DateTime
  otpSendCount  Int       @default(0)
  otpLastSentAt DateTime?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model EmailOtp {
  id      String     @id @default(uuid())
  email   String
  purpose OtpPurpose @default(LOGIN)

  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)

  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  createdAt DateTime  @default(now())
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Tenant {
  id                                   String                         @id @default(uuid())
  name                                 String
  slug                                 String                         @unique
  email                                String?
  phone                                String?
  addressLine1                         String?
  addressLine2                         String?
  city                                 String?
  state                                String?
  postalCode                           String?
  country                              String?
  timezone                             String?
  calendarAppointmentSlotMinutes       Int                            @default(30)
  calendarMeetingDurationMinutes       Int                            @default(30)
  calendarMinimumScheduleNoticeMinutes Int                            @default(0)
  calendarMaximumBookingsPerDay        Int?
  calendarMaximumBookingsPerSlot       Int                            @default(1)
  calendarPreBufferMinutes             Int                            @default(0)
  calendarPostBufferMinutes            Int                            @default(0)
  calendarBufferAvailabilityMode       CalendarBufferAvailabilityMode @default(BUSY)
  website                              String?
  taxEnabled                           Boolean                        @default(false)
  taxLabel                             String?
  defaultTaxRateBps                    Int?
  emailVerified                        Boolean                        @default(false)
  onboardingStatus                     TenantOnboardingStatus         @default(NOT_STARTED)
  onboardingCurrentStep                String                         @default("welcome")
  onboardingStartedAt                  DateTime?
  onboardingSkippedAt                  DateTime?
  onboardingCompletedAt                DateTime?
  onboardingChecklistDismissedAt       DateTime?

  members                           Membership[]
  files                             File[]
  invites                           Invite[]
  subscription                      TenantSubscription?
  contacts                          Contact[]
  tasks                             Task[]
  contactStatusConfigs              ContactStatusConfig[]
  taskStatusConfigs                 TaskStatusConfig[]
  taskReminders                     TaskReminder[]
  notifications                     Notification[]
  taskActivities                    TaskActivity[]
  linkedEntities                    TenantLinkedEntity[]
  services                          Service[]
  serviceChecklistItems             ServiceChecklistItem[]
  serviceFollowUpTemplates          ServiceFollowUpTemplate[]
  serviceFollowUpTemplateSteps      ServiceFollowUpTemplateStep[]
  serviceProfessionals              ServiceProfessional[]
  contactServices                   ContactService[]
  contactServiceChecklistItems      ContactServiceChecklistItem[]
  contactServiceChecklistActivities ContactServiceChecklistActivity[]
  contactServicePayments            ContactServicePayment[]
  contactServiceFollowUpSteps       ContactServiceFollowUpStep[]
  contactServiceNotes               ContactServiceNote[]
  serviceFollowUpExecutionLogs      ServiceFollowUpExecutionLog[]
  serviceFollowUpTemplateVersions   ServiceFollowUpTemplateVersion[]
  contactServiceFollowUpRuns        ContactServiceFollowUpRun[]
  followUpNodeExecutions            ServiceFollowUpNodeExecution[]
  opportunityPipelines              OpportunityPipeline[]
  opportunityPipelineStages         OpportunityPipelineStage[]
  contactOpportunities              ContactOpportunity[]
  tenantTags                        TenantTag[]
  contactTags                       ContactTag[]
  contactCustomFields               ContactCustomField[]
  contactCustomFieldValues          ContactCustomFieldValue[]
  contactCustomFieldAccessRequests  ContactCustomFieldAccessRequest[]
  contactCustomFieldAccessGrants    ContactCustomFieldAccessGrant[]
  contactRelationships              ContactRelationship[]
  contactNotes                      ContactNote[]
  contactNoteAttachments            ContactNoteAttachment[]
  contactServiceNoteAttachments     ContactServiceNoteAttachment[]
  appointments                      Appointment[]
  appointmentAuditLogs              AppointmentAuditLog[]
  calendarAvailabilityRules         CalendarAvailabilityRule[]
  calendarTimeBlocks                CalendarTimeBlock[]
  calendarStaffGroups               CalendarStaffGroup[]
  calendarStaffGroupMemberships     CalendarStaffGroupMember[]
  automations                       Automation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantLinkedEntity {
  id        String               @id @default(uuid())
  tenantId  String
  name      String
  type      TaskLinkedEntityType
  isActive  Boolean              @default(true)
  sortOrder Int                  @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, type, name])
  @@index([tenantId, type, sortOrder])
}

model Service {
  id                         String                @id @default(uuid())
  tenantId                   String
  name                       String
  description                String?
  fitProfile                 Json?
  basePriceCents             Int
  currency                   String                @default("USD")
  isTaxExempt                Boolean               @default(false)
  allowPartialPayments       Boolean               @default(false)
  minimumPartialPaymentCents Int?
  installmentCount           Int?
  installmentFrequency       InstallmentFrequency?
  isActive                   Boolean               @default(true)
  sortOrder                  Int                   @default(0)

  tenant                Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  checklistItems        ServiceChecklistItem[]
  followUpTemplates     ServiceFollowUpTemplate[]
  followUpTemplateSteps ServiceFollowUpTemplateStep[]
  professionals         ServiceProfessional[]
  contactServices       ContactService[]
  appointments          Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@unique([tenantId, name])
  @@index([tenantId, sortOrder])
  @@index([tenantId, isActive, sortOrder])
}

model ServiceChecklistItem {
  id          String  @id @default(uuid())
  tenantId    String
  serviceId   String
  label       String
  description String?
  isRequired  Boolean @default(true)
  sortOrder   Int     @default(0)

  tenant                Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service               Service                       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  contactChecklistItems ContactServiceChecklistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId, serviceId, sortOrder])
}

model ServiceFollowUpTemplate {
  id              String    @id @default(uuid())
  tenantId        String
  serviceId       String
  name            String
  sortOrder       Int       @default(0)
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  flowNodes       Json?
  flowEdges       Json?
  draftDefinition Json?
  needsRepair     Boolean   @default(false)
  activeVersionId String?   @unique

  tenant          Tenant                           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service         Service                          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  steps           ServiceFollowUpTemplateStep[]
  contactServices ContactService[]
  executionLogs   ServiceFollowUpExecutionLog[]
  tasks           Task[]
  contactNotes    ContactNote[]
  versions        ServiceFollowUpTemplateVersion[] @relation("FollowUpTemplateVersions")
  activeVersion   ServiceFollowUpTemplateVersion?  @relation("ActiveFollowUpTemplateVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId, serviceId, sortOrder])
}

model ServiceFollowUpTemplateVersion {
  id            String   @id @default(uuid())
  tenantId      String
  templateId    String
  versionNumber Int
  schemaVersion Int      @default(3)
  checksum      String
  definition    Json
  publishedById String?
  publishedAt   DateTime @default(now())

  tenant          Tenant                        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template        ServiceFollowUpTemplate       @relation("FollowUpTemplateVersions", fields: [templateId], references: [id], onDelete: Cascade)
  activeFor       ServiceFollowUpTemplate?      @relation("ActiveFollowUpTemplateVersion")
  publishedBy     User?                         @relation("ServiceFollowUpVersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  contactServices ContactService[]
  runs            ContactServiceFollowUpRun[]
  executionLogs   ServiceFollowUpExecutionLog[]
  tasks           Task[]
  contactNotes    ContactNote[]

  @@unique([templateId, versionNumber])
  @@unique([templateId, checksum])
  @@index([tenantId, templateId, publishedAt])
}

model ServiceFollowUpTemplateStep {
  id               String  @id @default(uuid())
  tenantId         String
  serviceId        String
  templateId       String?
  templateNodeId   String?
  title            String
  notesTemplate    String?
  dueDaysFromStart Int     @default(0)
  sortOrder        Int     @default(0)

  tenant   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service  Service                  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  template ServiceFollowUpTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId, serviceId, sortOrder])
  @@index([tenantId, templateId, sortOrder])
  @@index([tenantId, templateId, templateNodeId])
}

model ServiceProfessional {
  id                       String                  @id @default(uuid())
  tenantId                 String
  serviceId                String
  kind                     ServiceProfessionalKind
  userId                   String?
  externalProfessionalName String?
  externalContact          String?
  notes                    String?
  sortOrder                Int                     @default(0)

  tenant                  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service                 Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user                    User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  assignedContactServices ContactService[] @relation("ContactServiceAssignedProfessional")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId, serviceId, sortOrder])
  @@index([tenantId, userId])
}

model ContactService {
  id                        String               @id @default(uuid())
  tenantId                  String
  contactId                 String
  serviceId                 String
  followUpTemplateId        String?
  followUpTemplateVersionId String?
  followUpCoordinatorUserId String?
  assignedProfessionalId    String?
  status                    ContactServiceStatus @default(IN_PROGRESS)
  startedAt                 DateTime?
  purchasedAt               DateTime?
  completedAt               DateTime?
  canceledAt                DateTime?
  totalPriceCents           Int
  currency                  String               @default("USD")
  allowPartialPayments      Boolean              @default(false)
  notes                     String?

  tenant                  Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contact                 Contact                           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  service                 Service                           @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  followUpTemplate        ServiceFollowUpTemplate?          @relation(fields: [followUpTemplateId], references: [id], onDelete: SetNull)
  followUpTemplateVersion ServiceFollowUpTemplateVersion?   @relation(fields: [followUpTemplateVersionId], references: [id], onDelete: SetNull)
  followUpRun             ContactServiceFollowUpRun?
  followUpCoordinator     User?                             @relation("ContactServiceFollowUpCoordinator", fields: [followUpCoordinatorUserId], references: [id], onDelete: SetNull)
  assignedProfessional    ServiceProfessional?              @relation("ContactServiceAssignedProfessional", fields: [assignedProfessionalId], references: [id], onDelete: SetNull)
  payments                ContactServicePayment[]
  followUpSteps           ContactServiceFollowUpStep[]
  checklistItems          ContactServiceChecklistItem[]
  checklistActivities     ContactServiceChecklistActivity[]
  serviceNotes            ContactServiceNote[]
  executionLogs           ServiceFollowUpExecutionLog[]
  contactNotes            ContactNote[]
  tasks                   Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId, contactId, createdAt])
  @@index([tenantId, serviceId, createdAt])
  @@index([tenantId, followUpTemplateId])
  @@index([tenantId, followUpTemplateVersionId])
  @@index([tenantId, followUpCoordinatorUserId])
  @@index([tenantId, assignedProfessionalId])
  @@index([tenantId, status, createdAt])
}

model ContactServiceChecklistItem {
  id               String                        @id @default(uuid())
  tenantId         String
  contactServiceId String
  checklistItemId  String
  status           ContactServiceChecklistStatus @default(NOT_RECEIVED)
  completedAt      DateTime?

  tenant              Tenant                            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactService      ContactService                    @relation(fields: [contactServiceId], references: [id], onDelete: Cascade)
  checklistItem       ServiceChecklistItem              @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  checklistActivities ContactServiceChecklistActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, contactServiceId, checklistItemId])
  @@unique([tenantId, id])
  @@index([tenantId, contactServiceId, completedAt])
  @@index([tenantId, contactServiceId, status])
  @@index([tenantId, checklistItemId])
}

model ContactServiceChecklistActivity {
  id                            String                        @id @default(uuid())
  tenantId                      String
  contactServiceId              String
  contactServiceChecklistItemId String?
  itemLabel                     String
  previousStatus                ContactServiceChecklistStatus
  status                        ContactServiceChecklistStatus
  actorUserId                   String?

  tenant                      Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactService              ContactService               @relation(fields: [contactServiceId], references: [id], onDelete: Cascade)
  contactServiceChecklistItem ContactServiceChecklistItem? @relation(fields: [contactServiceChecklistItemId], references: [id], onDelete: SetNull)
  actor                       User?                        @relation("ContactServiceChecklistActivityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([tenantId, id])
  @@index([tenantId, contactServiceId, createdAt])
  @@index([tenantId, contactServiceChecklistItemId, createdAt])
  @@index([tenantId, actorUserId, createdAt])
}

model ContactServicePayment {
  id               String   @id @default(uuid())
  tenantId         String
  contactServiceId String
  amountCents      Int
  paidAt           DateTime
  paymentMethod    String?
  note             String?
  recordedById     String?

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactService ContactService @relation(fields: [contactServiceId], references: [id], onDelete: Cascade)
  recordedBy     User?          @relation("ContactServicePaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId, contactServiceId, paidAt])
}

model ContactServiceFollowUpStep {
  id                   String                           @id @default(uuid())
  tenantId             String
  contactServiceId     String
  runId                String?
  templateNodeId       String?
  title                String
  notesTemplate        String?
  status               ContactServiceFollowUpStepStatus @default(PENDING)
  availableAt          DateTime?
  dueAt                DateTime?
  completedAt          DateTime?
  resolutionSource     FollowUpStepResolutionSource?
  resolutionReason     String?
  assignedToUserId     String?
  resolvedByUserId     String?
  resolvedAt           DateTime?
  overdueNotifiedAt    DateTime?
  overdueNotifiedDueAt DateTime?
  note                 String?
  sortOrder            Int                              @default(0)

  tenant         Tenant                     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contactService ContactService             @relation(fields: [contactServiceId], references: [id], onDelete: Cascade)
  run            ContactServiceFollowUpRun? @relation(fields: [runId], references: [id], onDelete: SetNull)
  assignedTo     User?                      @relation("ContactServiceFollowUpAssignedUser", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  resolvedBy     User?                      @relation("ContactServiceFollowUpResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  contactNotes   ContactNote[]
  tasks          Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId, contactServiceId, sortOrder])
