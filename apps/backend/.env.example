# Backend configuration. Copy to apps/backend/.env on a fresh checkout.
# Real credentials belong in .env, which Git ignores.

# Local server and browser origins
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
# Optional additional frontend origins, separated by commas.
WEB_ADDITIONAL_ORIGINS=
# Leave empty for localhost. Set a parent domain for cross-subdomain deployment.
COOKIE_DOMAIN=

# PostgreSQL: replace this example with your development database connection.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gestiabloc?schema=public"
# Optional pool override: API defaults to 20, contact-import worker to 5 (5-100).
# PRISMA_POOL_MAX=20

# Encryption: independently generate each key with 32 random bytes in base64.
# node -e 'console.log(require("node:crypto").randomBytes(32).toString("base64"))'
# Keep existing keys when using an existing database.
CONTACT_CUSTOM_FIELD_ENCRYPTION_KEY=
CONTACT_SSN_ENCRYPTION_KEY=
AI_REPLAY_ENCRYPTION_KEY=

# Email: fill both values to deliver verification, password reset and login OTP.
# Local development logs delivery details when RESEND_API_KEY is empty.
RESEND_API_KEY=
# Use a sender from your verified Resend domain.
EMAIL_FROM="Gestiabloc <no-reply@example.com>"

# Supabase private files and AI documents. Use the same project in the frontend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=tenants-data

# AI: backend-only Groq credentials. Empty API key leaves rules-only behavior.
SERVICE_FIT_AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
# Optional model override, resolved from the server-owned AI model catalog.
AI_MODEL=
# Optional service-verification overrides; empty values use the settings above.
SERVICE_VERIFICATION_AI_PROVIDER=
SERVICE_VERIFICATION_AI_MODEL=
SERVICE_VERIFICATION_GROQ_MODEL=
SERVICE_VERIFICATION_GROQ_BASE_URL=

# Stripe: use the selected Gestiabloc sandbox's server-side credentials and IDs.
# Prefer a restricted rk_test_ key with the permissions needed by this backend.
# Fill after creating the sandbox catalog. Empty values are valid while disabled.
STRIPE_SECRET_KEY=
# Save the local signing secret: npm run stripe:listen -w backend -- --configure
# Then forward notifications: npm run stripe:listen -w backend
# A hosted endpoint has its own signing secret from Stripe Workbench.
STRIPE_WEBHOOK_SECRET=
# Portal: payment-method updates, invoice history, cancellation at period end.
# Keep portal subscription updates disabled; the app manages paid plan changes.
STRIPE_PORTAL_CONFIGURATION_ID=
# Three distinct monthly USD prices, one product per plan; no trials.
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
# Three distinct one-time USD prices for the additional-credit packs.
STRIPE_PRICE_AI_1000=
STRIPE_PRICE_AI_5000=
STRIPE_PRICE_AI_10000=

# Staged rollout: leave disabled until migrations, Stripe tests and model review pass.
BILLING_ENABLED=true
AI_CREDIT_ENFORCEMENT_ENABLED=false
AI_CREDIT_PURCHASES_ENABLED=false
AI_CREDIT_MODEL_GATE_PASSED=false
# Approve a specific reviewed model policy; comma-separate multiple approvals.
# Example only, after review: groq:openai/gpt-oss-120b@v1
# The legacy MODEL_GATE flag approves only that original model's v1 policy.
AI_CREDIT_APPROVED_MODELS=
AI_PROVIDER_METERING_ENABLED=false
AI_CREDIT_MAINTENANCE_INTERVAL_MS=60000

# Background features
AI_SOURCE_WORKER_ENABLED=true
CONTACT_IMPORTS_ENABLED=true
# The contact-import worker entrypoint sets CONTACT_IMPORT_WORKER=true itself.
# CONTACT_IMPORT_WORKER=true
AUTOMATION_ASYNC_EVENTS_ENABLED=false
# Optional automation overrides. Defaults reserve four database connections.
# Concurrency must fit PRISMA_POOL_MAX; worker-pool defaults may be smaller.
# AUTOMATION_EXECUTION_CONCURRENCY=4
# AUTOMATION_EXECUTION_TENANT_CONCURRENCY=2
AUTOMATION_EVENT_POLL_MS=1000
AUTOMATION_EVENT_CLAIM_SIZE=16
AUTOMATION_EVENT_METRICS_MS=60000
AUTOMATION_EVENT_FAILURE_ALERT_PERCENT=10

# Optional initial tenant: fill these before running npm run db:seed -w backend.
# Seeds create unpaid accounts. Stripe payment is required when billing is enabled.
SEED_TENANT_NAME="Gestiabloc Local"
SEED_TENANT_SLUG=gestiabloc-local
SEED_ADMIN_NAME="Local Admin"
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
SEED_PLAN_KEY=STARTER

# Optional integration/load tests: point only at disposable test databases.
# AI_CREDIT_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gestiabloc_test
# SERVICE_CONFIGURATION_TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gestiabloc_test
# SERVICE_LOAD_JOBS=5000
# SERVICE_LOAD_REPORT=/private/tmp/gestiabloc-load-report.json
# Opt-in tests below may write to the configured database or call real services.
# ACCOUNT_PROFILE_LIVE_TEST=1
# AI_SETTINGS_LIVE_TEST=1
# AI_SKILLS_LIVE_TEST=1
# AI_TEST_CHAT_LIVE_TEST=1
# AI_SOURCES_LIVE_TEST=1
# AI_SOURCES_REAL_AI_TEST=1
# AI_ANALYTICS_DB_TEST=1
# AI_CONTACT_ASSISTANT_DB_TEST=1
# AI_CONTACT_CASES_DB_TEST=1
